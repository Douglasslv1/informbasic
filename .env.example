# Não coloque valores reais no código ou em arquivos enviados para alunos.
# Em produção, cadastre os valores em Settings > Environment Variables na Vercel.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=CHAVE_SECRETA_SOMENTE_DO_SERVIDOR
ADMIN_PASSWORD=ESCOLHA_UMA_SENHA_FORTE_PARA_O_PROFESSOR
SESSION_SECRET=GERE_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
# Para usar o banco remoto também em desenvolvimento:
# STORAGE_MODE=supabase
